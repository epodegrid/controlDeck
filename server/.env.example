# ---------------------------------------------------------------------------
# controlDeck router — local sim-mode configuration.
# Copy to server/.env to run against the docker-compose stack.
#
# For production, leave SIM_MODE unset and see the README's deployment section.
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://controldeck:controldeck@localhost:5433/controldeck
PORT=4000

# Sim mode: mint local dev tokens without an Entra tenant, permit `npm run
# seed` and the traffic simulator. Never set this in production.
SIM_MODE=true

# Talk to the mock-model containers over real HTTP. Set to `fake` for an
# in-process stub with no network at all.
MODEL_BACKEND=http

# One address per replica. The reconciler probes each independently and creates
# a replica row per reachable endpoint; these must match docker-compose.yml.
MODEL_REPLICAS_ORNITH_35B=http://localhost:5001,http://localhost:5011
MODEL_REPLICAS_KESTREL_9B=http://localhost:5002,http://localhost:5012,http://localhost:5022
MODEL_REPLICAS_LARK_VISION=http://localhost:5003,http://localhost:5013
MODEL_REPLICAS_EMBER_EMBED=http://localhost:5004

# Token validation. In sim mode these only need to be internally consistent —
# the router signs and verifies with its own ephemeral key.
ENTRA_AUDIENCE=api://llm-gateway
ENTRA_ISSUER=https://login.microsoftonline.com/dev-tenant/v2.0
# ENTRA_JWKS_URI=   # required in production

# PRD §6.5 — two independent clocks.
QUEUE_TIMEOUT_MS=300000
STALL_TIMEOUT_MS=60000

# Replica reconciliation (PRD §6.4 readiness gating).
REPLICA_RECONCILE_INTERVAL_MS=5000
REPLICA_PROBE_TIMEOUT_MS=2000
