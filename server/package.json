{
  "name": "@controldeck/server",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:real-model": "vitest run --config vitest.real-model.config.ts",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "sim": "tsx --env-file-if-exists=.env src/sim/index.ts",
    "sim:backfill": "tsx --env-file-if-exists=.env src/sim/index.ts backfill",
    "sim:live": "tsx --env-file-if-exists=.env src/sim/index.ts live",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "openai": "^7.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.5"
  }
}
