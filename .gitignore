# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# compiled server output
server/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones stay local, the documented template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude
# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright-mcp/

# helm — the lock and the vendored subchart are both committed. An air-gapped
# cluster cannot reach a chart repository at install time, so KEDA has to ship
# in the tree rather than be fetched by `helm dependency update` on the way in.

# Production Folders (never committed)
production/
deployment/